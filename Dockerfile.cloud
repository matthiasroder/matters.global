FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/matters
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --no-cache-dir '.[cloud]' && \
    groupadd --system --gid 10001 matters && \
    useradd --system --uid 10001 --gid matters --create-home \
        --home-dir /var/lib/matters matters

USER 10001:10001
WORKDIR /var/lib/matters
EXPOSE 3000

# A non-loopback listener also requires --public-origin https://YOUR-HOST.
# Keep the database URL in MATTERS_CLOUD_DATABASE_URL, outside image layers.
ENTRYPOINT ["matters", "cloud"]
CMD ["--host", "0.0.0.0", "--port", "3000"]
